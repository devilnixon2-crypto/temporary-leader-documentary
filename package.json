{
  "name": "cutpaper-documentary-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Film out/film.mp4 --crf=16",
    "render:clips": "node scripts/render-clips.mjs",
    "sheet": "node scripts/contact-sheet.mjs",
    "typecheck": "tsc --noEmit",
    "render:audio": "remotion render src/index.ts Film out/film-with-voice.mp4 --crf=16 --props=./props-audio.json",
    "shotlist": "node scripts/shotlist.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}